{
  "name": "my-midway-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=local FORCE_ENABLE_COLOR=true midway-bin dev --ts",
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "test": "midway-bin test --ts",
    "cov": "midway-bin cov --ts",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "build": "midway-bin build -c",
    "generate": "tsproto --path proto --output src/domain",
    "migration:run": "mwtypeorm migration:run -d ./src/config/config.default.ts",
    "migration:revert": "mwtypeorm migration:revert -d ./src/config/config.default.ts",
    "migration:generate": "mwtypeorm migration:generate -d ./src/config/config.default.ts src/migration/migration"
  },
  "dependencies": {
    "@cool-midway/core": "^7.1.20",
    "@midwayjs/bootstrap": "3.20.11",
    "@midwayjs/core": "3.20.11",
    "@midwayjs/decorator": "3.20.11",
    "@midwayjs/grpc": "^3.20.12",
    "@midwayjs/jwt": "3.20.13",
    "@midwayjs/koa": "3.20.13",
    "@midwayjs/logger": "^4.0.1",
    "@midwayjs/passport": "3.20.13",
    "@midwayjs/typeorm": "3.20.11",
    "@midwayjs/validate": "3.20.13",
    "mysql2": "^3.15.1",
    "passport-jwt": "^4.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@midwayjs/cli": "^2.1.1",
    "@midwayjs/grpc-helper": "^1.1.0",
    "@types/koa": "^3.0.0",
    "@types/node": "18.19.127",
    "cross-env": "^10.0.0",
    "mwts": "^1.3.0",
    "typescript": "~5.9.2"
  },
  "midway-bin-clean": [
    ".vscode/.tsbuildinfo",
    "dist"
  ]
}
